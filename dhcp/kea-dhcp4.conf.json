{
    "Dhcp4": {
        "interfaces-config": {
            "interfaces": [ "eth0" ],
            "dhcp-socket-type": "raw"
        },
        "valid-lifetime": 4000,
        "renew-timer": 1000,
        "rebind-timer": 2000,
        "subnet4": [{
           "subnet": "192.168.10.0/24",
           "id": 1,
          "pools": [ 
            { "pool": "192.168.10.30-192.168.10.32",

              "option-data": [
                        {
                            "name": "routers",
                            "data": ["192.168.10.253"]
                         }
                ]
            },
            { "pool": "192.168.10.101-192.168.10.230" }
          ],
          "option-data":[
            {
              "name":"routers",
              "data":["192.168.10.254"]
            },
            {
             "name" :"domain-name",
             "data":"stark.lan"
            }
          ]

        }],

       "loggers": [{
            "name": "*",
            "severity": "DEBUG"
        }]
    }
}